# ==========================================================================
# AivexaClínica — variáveis de ambiente (NUNCA versionar o .env real)
# Segredos em produção: use o secrets manager do provedor (Docker secrets,
# AWS Secrets Manager, Vault...) e injete como variáveis de ambiente.
# ==========================================================================

APP_NAME=AivexaClinica
APP_BRAND_NAME="AivexaClínica"
# local | testing | staging | production
APP_ENV=local
# development | testing | homologation | production (exibido na interface)
APP_STAGE=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

# Hash de senha: automático (argon2id se disponível no PHP, senão bcrypt).
# HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Banco: MySQL 5.7+/MariaDB 10.3+ (HostGator/cPanel) — ou pgsql (PostgreSQL 13+) em VPS.
# No cPanel o nome do banco e do usuário recebem o prefixo da conta (ex.: conta_aivexa).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=conta_aivexa
DB_USERNAME=conta_aivexa
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sessão: cookie seguro, httpOnly, SameSite=lax, expira por inatividade
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Hospedagem compartilhada: sem Redis e sem processos permanentes.
# Filas no banco, processadas pelo cron (schedule:run a cada minuto).
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis apenas em VPS/Docker
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# HostGator: use a conta de e-mail criada no cPanel (SMTP SSL porta 465)
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=mail.seudominio.com.br
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@aivexa.local"
MAIL_FROM_NAME="${APP_BRAND_NAME}"

# ------------------------------------------------------------------ Segurança
LOGIN_RATE_PER_MINUTE=5
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15
SUPER_ADMIN_REQUIRES_2FA=true
PASSWORD_BREACH_CHECK=false
PASSWORD_MIN_LENGTH=10
API_TOKEN_TTL_MINUTES=720
SECURITY_HSTS=false
FORCE_HTTPS=false
# IPs/CIDRs dos proxies reversos confiáveis (ex.: 10.0.0.0/8)
TRUSTED_PROXIES=

# Instalador web (/instalar): defina um token longo e aleatório ANTES de enviar
# os arquivos; após a instalação o instalador se desativa (storage/app/installed.lock).
INSTALL_TOKEN=

# ------------------------------------------------ Integrações (fases futuras)
# Modo de cada integração: mock | sandbox | production
PAYMENT_PROVIDER=mock
ASAAS_MODE=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
CIELO_MODE=sandbox
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
AI_MODE=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Documentos e anexos (Fase 6)
# Tamanho máximo de anexo do paciente em KB (ajuste upload_max_filesize/post_max_size no cPanel).
UPLOAD_MAX_KB=10240
# Assinatura digital ICP-Brasil: none = impressão com assinatura de próprio punho.
SIGNATURE_DRIVER=none

# IA de atendimento (Fase 12) — deixe vazio para a clínica informar a própria chave na tela.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
