# ==========================================================================
# AivexaClínica — variáveis de ambiente (NUNCA versionar o .env real)
# Segredos em produção: use o secrets manager do provedor (Docker secrets,
# AWS Secrets Manager, Vault...) e injete como variáveis de ambiente.
# ==========================================================================

APP_NAME=AivexaClinica
APP_BRAND_NAME="AivexaClínica"
# local | testing | staging | production
APP_ENV=local
# development | testing | homologation | production (exibido na interface)
APP_STAGE=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

# Hash de senha: argon2id (recomendado OWASP)
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Banco: PostgreSQL 16+
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aivexa
DB_USERNAME=aivexa
DB_PASSWORD=
DB_SSLMODE=prefer

# Sessão: cookie seguro, httpOnly, SameSite=lax, expira por inatividade
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@aivexa.local"
MAIL_FROM_NAME="${APP_BRAND_NAME}"

# ------------------------------------------------------------------ Segurança
LOGIN_RATE_PER_MINUTE=5
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15
SUPER_ADMIN_REQUIRES_2FA=true
PASSWORD_BREACH_CHECK=false
PASSWORD_MIN_LENGTH=10
API_TOKEN_TTL_MINUTES=720
SECURITY_HSTS=false
FORCE_HTTPS=false
# IPs/CIDRs dos proxies reversos confiáveis (ex.: 10.0.0.0/8)
TRUSTED_PROXIES=

# ------------------------------------------------ Integrações (fases futuras)
# Modo de cada integração: mock | sandbox | production
PAYMENT_PROVIDER=mock
ASAAS_MODE=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
CIELO_MODE=sandbox
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
AI_MODE=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
