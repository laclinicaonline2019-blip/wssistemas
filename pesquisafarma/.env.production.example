# ============================================================
#  Pesquisa Farma — .env de PRODUÇÃO (copie para .env e preencha)
#  Depois rode: php artisan pf:verificar --testar-ia
# ============================================================
APP_NAME="Pesquisa Farma"
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false
APP_URL=https://app.seudominio.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pesquisafarma
DB_USERNAME=pesquisafarma
DB_PASSWORD=                  # senha forte

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
# Atrás de Cloudflare/balanceador: TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# --- WhatsApp: zapi | evolution | meta ---
WHATSAPP_DRIVER=zapi
WHATSAPP_WEBHOOK_SECRET=      # php -r "echo bin2hex(random_bytes(20));"
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- IA (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
CEP_LOOKUP=true
