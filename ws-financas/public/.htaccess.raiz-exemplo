# SOMENTE se não for possível apontar o domínio/subdomínio para a pasta /public (docs/INSTALACAO-CPANEL.md, opção B).
# Substitua o .htaccess da RAIZ do projeto por este conteúdo: tudo é encaminhado para /public e
# .env, storage, vendor e demais pastas internas ficam inacessíveis.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|\.git|storage|vendor|database|app|config|routes|bootstrap|resources|deploy|docs|lang|tests)(/|$) - [F,L]
    RewriteRule ^(composer\.(json|lock)|artisan|VERSION|wsf-update\.(json|sig)|CHECKSUMS\.sha256|.*\.md)$ - [F,L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
