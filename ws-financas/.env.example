# =========================================================================
# WS Finanças em Dia — variáveis de ambiente (NUNCA versionar o .env real)
# Na HostGator o .env fica FORA da pasta pública (public_html aponta para /public).
# =========================================================================
APP_NAME="WS Finanças em Dia"
APP_ENV=production
# production | homologation | development (faixa de aviso fora da produção)
APP_STAGE=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL/MariaDB do cPanel (nome do banco e usuário com prefixo da conta)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=conta_wsfinancas
DB_USERNAME=conta_wsfinancas
DB_PASSWORD=

# Hospedagem compartilhada: sessão, cache e fila no banco (sem Redis, sem processo permanente)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# E-mail (recuperação de senha) — use o SMTP do cPanel ou um serviço transacional
MAIL_MAILER=smtp
MAIL_HOST=mail.seudominio.com.br
MAIL_PORT=465
MAIL_USERNAME=nao-responda@seudominio.com.br
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=nao-responda@seudominio.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Segurança
AUDIT_HMAC_KEY=
BACKUP_PASSWORD=
BACKUP_MANTER=14
PASSWORD_BREACH_CHECK=true
WSF_2FA_PLATAFORMA=true
WSF_2FA_ADMIN_CLIENTE=true
# Fuso somente da conexão da aplicação com o MySQL (preserva o histórico UTC−3; não altera o servidor)
DB_TIMEZONE=-03:00
# Auditoria: âncora diária por e-mail (vazio = proprietários) e carimbo RFC 3161 desativado nesta versão
WSF_AUDIT_ANCORA_EMAIL=true
WSF_AUDIT_ANCORA_DESTINO=
WSF_AUDIT_TSA=off
# Cloudflare/proxy: lista de IPs confiáveis ou *
TRUSTED_PROXIES=

# Políticas comerciais (também editáveis no painel do proprietário)
WSF_TRIAL_DIAS=14
WSF_CARENCIA_DIAS=7
WSF_RETENCAO_APOS_CANCELAMENTO=90
WSF_RETENCAO_MENSAGENS=180
WSF_RETENCAO_AUDITORIA=1825
WSF_SUPPORT_EMAIL=suporte@seudominio.com.br

# WhatsApp Business — Cloud API oficial da Meta (mock = simulado)
WHATSAPP_MODE=mock
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
# Modelo aprovado para lembretes (vazio = sem lembretes). Parâmetros: {{1}} quantidade, {{2}} total
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_LANG=pt_BR

# Asaas — cobrança das assinaturas (mock = simulado)
BILLING_MODE=mock
ASAAS_API_KEY=
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_TOKEN=

# Inteligência artificial (Claude) — opcional; usada só quando as regras não entendem a mensagem
WSF_IA=auto
ANTHROPIC_API_KEY=
WSF_AI_MODEL=claude-opus-5-5
WSF_IA_ESFORCO=low
